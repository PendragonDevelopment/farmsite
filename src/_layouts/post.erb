---
layout: default
---

<article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <header class="mb-10">
    <h1 class="font-display text-3xl md:text-4xl font-bold text-farm-green mb-3"><%= data.title %></h1>
    <time class="text-sm text-farm-brown-light" datetime="<%= data.date %>">
      <%= data.date.strftime("%B %d, %Y") %>
    </time>
  </header>
  <div class="prose prose-lg prose-stone max-w-none">
    <%= yield %>
  </div>
</article>
