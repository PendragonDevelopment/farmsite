<footer class="bg-farm-brown text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Brand -->
      <div>
        <h3 class="font-display text-2xl font-bold mb-4"><%= metadata.title %></h3>
        <p class="text-stone-300 text-sm leading-relaxed"><%= metadata.description %></p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-semibold text-farm-gold mb-4 uppercase tracking-wider text-sm">Visit</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="<%= relative_url '/animals' %>" class="text-stone-300 hover:text-white transition-colors">Meet the Animals</a></li>
          <li><a href="<%= relative_url '/pick-your-own' %>" class="text-stone-300 hover:text-white transition-colors">Pick Your Own</a></li>
          <li><a href="<%= relative_url '/about' %>" class="text-stone-300 hover:text-white transition-colors">Our Story</a></li>
          <li><a href="<%= metadata.booking_url %>" target="_blank" rel="noopener" class="text-stone-300 hover:text-white transition-colors">Book a Stay</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-semibold text-farm-gold mb-4 uppercase tracking-wider text-sm">Contact</h4>
        <ul class="space-y-2 text-sm text-stone-300">
          <li><%= metadata.address %></li>
          <li><a href="tel:<%= metadata.phone %>" class="hover:text-white transition-colors"><%= metadata.phone %></a></li>
          <li><a href="mailto:<%= metadata.email %>" class="hover:text-white transition-colors"><%= metadata.email %></a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-stone-600 text-center text-stone-400 text-sm">
      &copy; <%= Date.today.year %> <%= metadata.title %>. All rights reserved.
    </div>
  </div>
</footer>
