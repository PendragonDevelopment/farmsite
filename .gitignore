# Bridgetown
output
.bridgetown-cache
.bridgetown-metadata
.routes.json

# Dependency folders
node_modules

# Ruby gems. CI (ruby/setup-ruby with bundler-cache) installs these into
# vendor/bundle INSIDE the project. Tailwind v4 auto-detects content from
# the project root and honors .gitignore, so leaving vendor/ untracked here
# is what keeps gem sources and .rdoc docs out of the compiled CSS.
vendor

# Caches
.sass-cache
.npm
.node_repl_history

# Ignore bundler config.
/.bundle

# Ignore Byebug command history file.
.byebug_history

# dotenv environment variables file
.env

# Cloudflare local secrets + wrangler local state
.dev.vars
.wrangler

# Mac files
.DS_Store

# Yarn
yarn-error.log
yarn-debug.log*
.pnp/
.pnp.js
# Yarn Integrity file
.yarn-integrity

# Ignore all tempfiles.
/tmp/*
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

frontend/styles/jit-refresh.css
