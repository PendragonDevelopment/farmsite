{
  "name": "farmsite",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "esbuild": "node esbuild.config.js --minify",
    "esbuild-dev": "node esbuild.config.js --watch",
    "cf:dev": "bin/bridgetown build && wrangler pages dev",
    "cf:deploy": "bin/bridgetown deploy && wrangler pages deploy",
    "db:migrate:local": "wrangler d1 migrations apply farmstead-scorecard --local",
    "db:migrate": "wrangler d1 migrations apply farmstead-scorecard --remote"
  },
  "devDependencies": {
    "wrangler": "^4.123.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "esbuild": "^0.25.11",
    "glob": "^11.0.3",
    "postcss": "^8.5.6",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^16.1.0",
    "postcss-load-config": "^6.0.1",
    "postcss-preset-env": "^10.4.0",
    "read-cache": "^1.0.0",
    "tailwindcss": "^4.2.2"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^8.0.23",
    "turbo-shadow": "^1.2.0"
  }
}
